DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_USE_SQLITE=false
# Option A (recommended for your teacher requirement): Supabase Postgres (online DB)
# Get this from Supabase -> Project Settings -> Database -> Connection string (URI)
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Optional (only if you plan to call Supabase REST APIs / Storage / Auth from Python):
# SUPABASE_URL=https://YOUR_REF.supabase.co
# SUPABASE_KEY=YOUR_ANON_OR_SERVICE_KEY

# Option B (local-only fallback): SQLite
# DATABASE_URL=sqlite:///db.sqlite3
